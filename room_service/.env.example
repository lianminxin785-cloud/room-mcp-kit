# Room REST service
ROOM_TOKEN=replace-with-at-least-16-random-characters
ROOM_DB=room_service/data/room.db
ROOM_INITIAL_STATE=web/room/data/initial-state.json
ROOM_MAP=web/room/data/room-map.json
ROOM_HOST=127.0.0.1
ROOM_PORT=18451

# Room MCP is a separate loopback process sharing ROOM_DB
MCP_HOST=127.0.0.1
MCP_PORT=18452
MCP_TRANSPORT=streamable-http
